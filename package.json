{
  "name": "angular-pokedex-app",
  "version": "0.0.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "ng": "ng",
    "prebuild": "mkdir -p public/assets/leaflet && cp -r node_modules/leaflet/dist/images/* public/assets/leaflet/",
    "start": "ng serve",
    "start:api": "json-server db.json",
